{
  "schema_version": "1.0",
  "case_aggregation": "arithmetic mean across ROIs within each case",
  "classifier": {
    "class": "sklearn.linear_model.LogisticRegression",
    "penalty": "l2",
    "C": 1.0,
    "solver": "liblinear",
    "class_weight": "balanced",
    "max_iter": 1000,
    "random_state": 0
  },
  "standardization": {
    "class": "sklearn.preprocessing.StandardScaler",
    "fit_scope": "training cases only within each LOOCV fold"
  },
  "validation": {
    "method": "leave-one-case-out cross-validation",
    "prediction_output": "positive-class probability"
  },
  "bootstrap": {
    "valid_resamples": 2000,
    "sampling_unit": "case",
    "sample_size": "same as the task cohort",
    "replacement": true,
    "reject_single_class_draws": true,
    "confidence_interval": "2.5th and 97.5th percentiles",
    "random_seed": 0
  },
  "single_feature_ranking": {
    "metric": "orientation-independent AUC",
    "formula": "max(raw_auc, 1 - raw_auc)"
  }
}
